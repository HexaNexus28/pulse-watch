# API Configuration
VITE_API_URL=https://localhost:7171/api

# PWA Configuration
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Application Settings
VITE_APP_NAME=PulseWatch
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Tech Intelligence Dashboard

# Feature Flags
VITE_ENABLE_OFFLINE_SUPPORT=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_BACKGROUND_SYNC=true

# Development Settings
VITE_DEV_TOOLS=true
VITE_LOG_LEVEL=info
