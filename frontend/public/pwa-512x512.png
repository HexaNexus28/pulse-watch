<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background with gradient -->
  <defs>
    <linearGradient id="bgGradientXL" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1D4ED8;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="pulseGradientXL" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#60A5FA;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3B82F6;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="chartGradientXL" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
    <!-- Shadow filter -->
    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
      <feOffset dx="0" dy="4" result="offsetblur"/>
      <feFlood flood-color="#000000" flood-opacity="0.2"/>
      <feComposite in2="offsetblur" operator="in"/>
      <feMerge>
        <feMergeNode/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Main background rounded rectangle with shadow -->
  <rect x="32" y="32" width="448" height="448" rx="128" fill="url(#bgGradientXL)" filter="url(#shadow)"/>
  
  <!-- Pulse wave lines representing data flow -->
  <path d="M 96 256 Q 160 192, 224 256 T 352 256 T 416 256" 
        stroke="url(#pulseGradientXL)" 
        stroke-width="20" 
        fill="none" 
        stroke-linecap="round"
        opacity="0.9"/>
  
  <!-- Trend chart line showing growth -->
  <polyline points="128,320 192,288 256,224 320,192 384,160" 
            stroke="url(#chartGradientXL)" 
            stroke-width="16" 
            fill="none" 
            stroke-linecap="round" 
            stroke-linejoin="round"
            opacity="0.8"/>
  
  <!-- Data points on trend line -->
  <circle cx="128" cy="320" r="16" fill="#10B981"/>
  <circle cx="192" cy="288" r="16" fill="#10B981"/>
  <circle cx="256" cy="224" r="20" fill="#059669"/>
  <circle cx="320" cy="192" r="16" fill="#10B981"/>
  <circle cx="384" cy="160" r="16" fill="#10B981"/>
  
  <!-- Central monitoring eye/watch symbol -->
  <g transform="translate(256, 256)">
    <!-- Outer ring -->
    <circle cx="0" cy="0" r="64" fill="none" stroke="white" stroke-width="8" opacity="0.9"/>
    <!-- Middle ring -->
    <circle cx="0" cy="0" r="32" fill="white" opacity="0.8"/>
    <!-- Inner circle -->
    <circle cx="0" cy="0" r="16" fill="#1D4ED8"/>
    <!-- Center dot -->
    <circle cx="0" cy="0" r="8" fill="white" opacity="0.9"/>
  </g>
  
  <!-- RSS signal waves representing data feeds -->
  <g transform="translate(256, 256)" opacity="0.7">
    <!-- Inner wave -->
    <path d="M -48 -48 Q 0 -64, 48 -48" stroke="white" stroke-width="8" fill="none" stroke-linecap="round"/>
    <!-- Outer wave -->
    <path d="M -80 -80 Q 0 -104, 80 -80" stroke="white" stroke-width="8" fill="none" stroke-linecap="round"/>
  </g>
  
  <!-- Decorative elements representing tech/data -->
  <g opacity="0.3">
    <!-- Data dots -->
    <circle cx="120" cy="120" r="4" fill="white"/>
    <circle cx="392" cy="120" r="4" fill="white"/>
    <circle cx="120" cy="392" r="4" fill="white"/>
    <circle cx="392" cy="392" r="4" fill="white"/>
    
    <!-- Connection lines -->
    <line x1="120" y1="120" x2="160" y2="160" stroke="white" stroke-width="2" stroke-linecap="round"/>
    <line x1="392" y1="120" x2="352" y2="160" stroke="white" stroke-width="2" stroke-linecap="round"/>
    <line x1="120" y1="392" x2="160" y2="352" stroke="white" stroke-width="2" stroke-linecap="round"/>
    <line x1="392" y1="392" x2="352" y2="352" stroke="white" stroke-width="2" stroke-linecap="round"/>
  </g>
</svg>
