# ============================================================================
# PulseWatch — modèle de configuration. Copier en .env et renseigner.
# ============================================================================
# Les valeurs réelles ne vivent jamais dans le dépôt : .env est gitignoré, et
# appsettings.json ne contient plus aucun secret.
#
# Le double souligné correspond à l'imbrication .NET :
# Jwt__Key => section "Jwt", clé "Key".
# ============================================================================

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=

# ---------------------------------------------------------------------------
# Signature des jetons — obligatoire, 32 caractères minimum.
# Absente, l'API refuse de démarrer plutôt que de signer avec une clé connue.
# Générer : openssl rand -base64 48
# ---------------------------------------------------------------------------
Jwt__Key=
Jwt__Issuer=PulseWatch
Jwt__Audience=PulseWatch

# ---------------------------------------------------------------------------
# Origines autorisées en production (ProductionPolicy dans Program.cs).
# Liste vide = aucune origine acceptée : le frontend ne joindra pas l'API.
# Une entrée par index.
# ---------------------------------------------------------------------------
Cors__AllowedOrigins__0=
