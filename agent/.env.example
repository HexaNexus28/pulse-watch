# Copier en digest_agent/.env — ce fichier-la est gitignore.
#
# ADK charge le .env du dossier de l'agent, pas celui-ci.
#
# --- Modele ---------------------------------------------------------------
# Trois formes possibles, au choix :
#
#   1. Gemini (natif ADK, pas de LiteLLM)
#      DIGEST_MODEL=gemini-2.5-flash
#      GOOGLE_API_KEY=...
#
#   2. Un provider via LiteLLM (NVIDIA NIM, Groq, Anthropic...)
#      DIGEST_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b
#      NVIDIA_NIM_API_KEY=...
#
#   3. Le proxy LiteLLM de nexus-switch, si tu le demarres (aucune cle ici)
#      DIGEST_MODEL=openai/<nom-du-modele-expose-par-le-proxy>
#      OPENAI_API_BASE=http://127.0.0.1:4000
#      OPENAI_API_KEY=<NEXUS_PROXY_KEY>
#
DIGEST_MODEL=gemini-2.5-flash
